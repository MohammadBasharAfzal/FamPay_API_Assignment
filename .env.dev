PORT=3000
MONGODB_URI=mongodb://mongo:27017/fampay

YOUTUBE_API_KEYS=key1,key2,key3

# Cron job to run every 1 minute
FETCH_VIDEO_CRON=*/1 * * * *

# Max results to fetch per API call
MAX_RESULT_SIZE=10

# Time window in seconds to fetch recently published videos
FETCH_TIME_SEC=60

# YouTube API search settings
YOUTUBE_SEARCH_QUERY=football
YOUTUBE_SEARCH_ORDER=date
